pipeline {
    agent { 
        node {
            label 'docker-agent-python'
            } 
    }
    parameters {
        string(name: 'NEW_VERSION', defaultValue: '1.1.1', description: 'Version to build and deliver')
        choice(name: 'ENVIRONMENT', choices: ['dev', 'qa', 'prod'], description: 'Environment to deploy to')
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Run tests after build?')
    }
    triggers {
        pollSCM '*/5 * * * *'
    }
    environment {
        SERVER_CREDENTIALS = credentials('globalkll')
    }
    stages {
        stage('Build') {
            steps {
                echo "Building..the application"
                echo "Building version ${params.NEW_VERSION}"
                sh '''
                cd myapp
                python3 -m venv .venv
                . .venv/bin/activate
                python -m pip install -r requirements.txt
                '''
            }
        }
        stage('Test') {
            steps {
                echo "Testing.."
                sh '''
                cd myapp
                .venv/bin/python hello.py --name "Yoona"
                .venv/bin/python hello.py --name "Seohyun"
                '''
            }
        }
        stage('Deliver') {
            steps {
                echo 'Deliver....'
                sh '''
                echo "doing delivery stuff.."
                echo "Delivering version ${NEW_VERSION} to server"
                '''
            }
        }
    }
    post {
        always {
            echo 'Cleaning up...'
            sh '''
            cd myapp
            rm -rf .venv
            '''
        }
        success{
            echo 'Build completed successfully!'
        }

    }
}