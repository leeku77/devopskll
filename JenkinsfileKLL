pipeline {
    agent { 
        node {
            label 'docker-agent-python'
            }
      }
    triggers {
        pollSCM '*/5 * * * *'
    }
    environment {
        NEW_VERSION = "1.1.1"
        SERVER_CREDENTIALS = credentials('globalkll')
    }
    stages {
        stage('Build') {
            steps {
                echo "Building..the application"
                echo "Building version ${NEW_VERSION}"
                sh '''
                cd myapp
                python3 -m venv .venv
                . .venv/bin/activate
                python -m pip install -r requirements.txt
                '''
            }
        }
        stage('Test') {
            steps {
                echo "Testing.."
                sh '''
                cd myapp
                .venv/bin/python hello.py --name "Yoona"
                .venv/bin/python hello.py --name "Seohyun"
                '''
            }
        }
        stage('Deliver') {
            steps {
                echo 'Deliver....'
                sh '''
                echo "doing delivery stuff.."
                '''
            }
        }
    }
    post {
        always {
            echo 'Cleaning up...'
            sh '''
            cd myapp
            rm -rf .venv
            '''
        }
        success{
            echo 'Build completed successfully!'
        }

    }
}